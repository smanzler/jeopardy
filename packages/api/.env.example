# Copy to .env. src/env.ts holds the schema.
PORT=4000

# Local Postgres from docker-compose.yml. Use the direct (not pooled) Neon URL
# in production.
DATABASE_URL=postgres://jeopardy:jeopardy@localhost:5432/jeopardy

# Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin of the web app, not of the API.
BETTER_AUTH_URL=http://localhost:3100

# The defaults send to Mailpit from docker-compose.yml. Read the mail at
# http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Jeopardy <noreply@jeopardy.local>
